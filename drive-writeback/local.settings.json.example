{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "DRIVE_WRITEBACK_TENANT_ID": "<App registration tenant>",
    "DRIVE_WRITEBACK_CLIENT_ID": "<App registration client>",
    "DRIVE_WRITEBACK_KEY_VAULT_URI": "<Azure function's Keyvault URL>",
    "DRIVE_WRITEBACK_DRY_RUN": "true",
    "DRIVE_WRITEBACK_MAX_CONTENT_BYTES": "1048576"
  }
}
